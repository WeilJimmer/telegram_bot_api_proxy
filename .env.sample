# Telegram
BOT_TOKEN=your_bot_token_here
TELEGRAM_API_BASE=https://api.telegram.org

# 多重身份（選用）
# BOT_TOKENS 是 token 陣列，索引 0 為預設身份；留空則沿用上面的單一 BOT_TOKEN。
# BOT_TOKEN_PROFILES 把請求裡的 X-MY-NAME 對應到 BOT_TOKENS 的索引。
# IS_BOT_PROFILE_REQUIRED=true 時，所有請求都必須帶 X-MY-NAME。
BOT_TOKENS=
BOT_TOKEN_PROFILES=
IS_BOT_PROFILE_REQUIRED=false
# reportToMaster / askMasterForPermission 功能使用的固定主人 chat_id
MASTER_CHAT_ID=

# Poll storage backend (for askMasterForPermission / getResultFromMaster)
# 留空使用本機檔案系統（POLL_STORE_DIR）；填入 Redis URL 改用 Redis。
REDIS_URL=
POLL_STORE_DIR=/tmp/tg_proxy_polls

# Proxy Auth
# 空字串可關閉驗證
API_KEY=your_proxy_api_key_here

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=15820

# Access Control (JSON 字串)
ALLOWED_CHAT_IDS=["*"]
ALLOWED_METHODS={"*":["*"]}
GLOBAL_ALLOWED_METHODS=["getMe"]
